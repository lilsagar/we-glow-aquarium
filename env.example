# Copy to .env.local (gitignored). See DEPLOYMENT.md for Vercel setup.

# Application URL (use for eSewa payment redirects in production)
# On Vercel: https://your-project.vercel.app
# Locally: http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Firebase Web App (Firebase Console → Project settings → Your apps → Web)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin credentials for server-side order verification
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Comma-separated admin emails allowed to sign in
NEXT_PUBLIC_ADMIN_EMAILS=pandeysagar832@gmail.com

# eSewa sandbox HMAC secret key for v2 signature generation
# Set this in .env.local and do not commit it.
ESEWA_SECRET_KEY=REPLACE_WITH_YOUR_TEST_SECRET
